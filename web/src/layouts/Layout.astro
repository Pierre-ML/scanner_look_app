---
/** Gabarit unique du site. */
import "../styles/global.css";
import { DEPOT, SITE, EDITEUR } from "../lib/identite.js";
import Icone from "../components/Icone.astro";
import Logo from "../components/Logo.astro";

const {
	titre,
	description = SITE.description,
	// Les pages de job (`/rapport`, `/decouverte`) affichent un état qui change en continu : les
	// remettre en cache servirait un avancement périmé, ou un rapport vide là où l'audit est terminé.
	sansCache = false,
	/** Largeur de page élargie (rapport, tableau de huit colonnes de scores). */
	large = false,
	/** Le monogramme de l'en-tête se dessine à l'arrivée : réservé à l'accueil. */
	logoAnime = false,
} = Astro.props;

/** Chemin courant, pour signaler la page active dans la navigation (`aria-current`). */
const chemin = Astro.url.pathname;

const titreComplet = titre ? `${titre} — ${SITE.nom}` : SITE.titre;
---

<!doctype html>
<html lang="fr" data-theme="obsidian" class="scroll-smooth motion-reduce:scroll-auto">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{titreComplet}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		{
			/* Sur un site statique, il n'y a pas de serveur Astro pour poser un en-tête : l'équivalent est
			   cette balise, doublée par la consigne de configuration du serveur statique documentée dans le
			   README (`Cache-Control: no-store` sur /rapport/* et /decouverte/*). */
			sansCache && (
				<>
					<meta http-equiv="cache-control" content="no-store, no-cache, must-revalidate" />
					<meta http-equiv="pragma" content="no-cache" />
					<meta http-equiv="expires" content="0" />
					<meta name="robots" content="noindex, nofollow" />
				</>
			)
		}

		{/* La police est chargée par `@font-face` ; le préchargement évite le saut de texte. */}
		<link rel="preload" href="/fonts/surgena.ttf" as="font" type="font/ttf" crossorigin />
	</head>

	{/* Réglages valables pour toute l'interface, posés une fois ici : */}
	<body
		class="relative isolate flex min-h-dvh flex-col bg-obsidian font-corps text-cream antialiased **:focus-visible:rounded-[0.25rem] **:focus-visible:outline-2 **:focus-visible:outline-offset-2 **:focus-visible:outline-cream motion-reduce:**:animate-none! motion-reduce:**:transition-none! motion-reduce:**:after:animate-none!"
	>
		{/* Fond du site : grille de points du HUD, estompée vers le bas, et une lueur carmin très basse
		    en haut de page. */}
		<div
			aria-hidden="true"
			class="pointer-events-none fixed inset-0 -z-1 [background-image:radial-gradient(60%_45%_at_50%_-8%,rgb(122_12_13/0.22),transparent_70%),radial-gradient(rgb(247_242_232/0.06)_1px,transparent_1px)] [background-size:100%_100%,24px_24px] [mask-image:linear-gradient(to_bottom,black_0%,black_55%,transparent_100%)]"
		></div>

		{/* Lien d'évitement : premier élément focusable du document, avant toute navigation. */}
		<a
			href="#contenu"
			class="btn btn-secondary btn-sm fixed top-2 left-2 z-100 -translate-y-[200%] transition-[translate] duration-150 ease-douce focus-visible:translate-y-0"
			>Aller au contenu</a
		>

		{/* En-tête collant, sur un voile flouté : la navigation reste à portée pendant la lecture d'un
		    long rapport, sans masquer le texte qui défile dessous. */}
		<header class="sticky top-0 z-40 border-b border-obsidian-border bg-obsidian/80 backdrop-blur-md">
			<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
				<a href="/" class="group flex items-center gap-3" aria-label={`${SITE.nom} — accueil`}>
					<Logo mode={logoAnime ? "entree" : "fixe"} classe="h-7 w-auto text-cream transition-colors duration-200 group-hover:text-cream-muted" />
					{/* Le nom s'efface sous `sm` : sur un téléphone, le monogramme et la navigation suffisent. */}
					<span class="hidden h-5 w-px bg-obsidian-border sm:block" aria-hidden="true"></span>
					<span class="hidden font-titre text-lg tracking-wide sm:inline">{SITE.nom}</span>
				</a>
				<nav aria-label="Navigation principale">
					<ul class="flex items-center gap-1 text-sm">
						<li>
							<a
								href="/"
								aria-current={chemin === "/" ? "page" : undefined}
								class="btn btn-ghost btn-sm gap-2 font-normal aria-[current=page]:text-cream text-cream-muted"
							>
								<Icone nom="loupe" taille={16} classe="text-primary" />
								<span class="hidden sm:inline">Nouvel audit</span>
								<span class="sm:hidden">Auditer</span>
							</a>
						</li>
						<li>
							<a
								href="/mes-audits"
								aria-current={chemin.startsWith("/mes-audits") ? "page" : undefined}
								class="btn btn-ghost btn-sm gap-2 font-normal aria-[current=page]:text-cream text-cream-muted"
							>
								<Icone nom="document" taille={16} classe="text-primary" />
								Mes audits
								{/* Rempli par le script ci-dessous : le nombre vient du serveur local. */}
								<span data-compteur-audits hidden class="badge badge-sm border-obsidian-border bg-obsidian-hover text-cream tabular-nums"></span>
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		{/* `tabindex="-1"` : sans lui, Safari déplace l'ancre sans déplacer le focus. */}
		<main id="contenu" tabindex="-1" class:list={["mx-auto w-full flex-1 px-4 sm:px-6", large ? "max-w-6xl" : "max-w-5xl", "py-10 sm:py-14"]}>
			<slot />
		</main>

		<footer class="mt-16 border-t border-obsidian-border">
			<div
				class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-cream-dark sm:flex-row sm:items-center sm:justify-between sm:px-6"
			>
				<p class="flex items-center gap-3">
					<Logo classe="h-5 w-auto text-cream-dark" />
					<span>
						Conçu par{" "}
						<a href={EDITEUR.site} class="text-cream-muted hover:text-cream hover:underline">{EDITEUR.nom}</a>
						{" "}— {EDITEUR.ville}
					</span>
				</p>
				<ul class="flex flex-wrap gap-x-4 gap-y-1">
					<li>Outil local : aucune donnée ne quitte votre machine</li>
					<li>
						<a href={DEPOT.url} class="hover:text-cream hover:underline">
							Code source ({DEPOT.licence})
						</a>
					</li>
				</ul>
			</div>
		</footer>

		<script>
			/* Pastille « Mes audits » : le nombre d'audits enregistrés par le serveur local. */
			import { routes } from "../lib/api.js";

			const pastille = document.querySelector<HTMLElement>("[data-compteur-audits]");
			fetch(routes.historique(), { headers: { Accept: "application/json" }, cache: "no-store" })
				.then((reponse) => (reponse.ok ? reponse.json() : null))
				.then((corps) => {
					const nombre = Array.isArray(corps?.jobs) ? corps.jobs.length : 0;
					if (pastille && nombre > 0) {
						pastille.textContent = String(nombre);
						pastille.hidden = false;
					}
				})
				.catch(() => {});
		</script>
	</body>
</html>
