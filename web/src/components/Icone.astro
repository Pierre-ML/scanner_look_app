---
/** Une icône du jeu de `src/assets/icons/*.svg`. */

/** Tous les fichiers du dossier, indexés par leur nom sans extension. */
const fichiers = import.meta.glob("../assets/icons/*.svg", { eager: true, import: "default" });
const icones: Record<string, any> = Object.fromEntries(
	Object.entries(fichiers).map(([chemin, composant]) => [chemin.split("/").pop().replace(/\.svg$/, ""), composant]),
);

const { nom, taille = 20, classe = "", titre = null, id = null } = Astro.props;

const Svg = icones[nom];
if (!Svg) {
	// Une faute de frappe sur un nom d'icône doit casser le build, pas produire un trou silencieux
	// dans la page.
	throw new Error(
		`Icône inconnue : « ${nom} ». Noms disponibles : ${Object.keys(icones).join(", ")}.`,
	);
}
---

{/* `id` est un prop nommé explicitement, pas un passe-plat générique : il sert seulement quand un
    script doit retrouver une icône précise pour changer son dessin après coup (voir
    `IndicateursSysteme.astro`). */}
<Svg
	id={id ?? undefined}
	width={taille}
	height={taille}
	class={classe}
	role={titre ? "img" : undefined}
	aria-hidden={titre ? undefined : "true"}
	aria-label={titre ?? undefined}
	focusable="false"
/>
