---
import Layout from "../layouts/Layout.astro";
import Icone from "../components/Icone.astro";
import BandeauEcoindex from "../components/BandeauEcoindex.astro";
import IndicateursSysteme from "../components/IndicateursSysteme.astro";
import Chargeur from "../components/Chargeur.astro";
import { routes } from "../lib/api.js";
import { PLAFOND_PAGES } from "../lib/identite.js";

/**
 * `prerender = true` : explicite, bien que ce soit le défaut en `output: 'static'`. Cette page
 * est entièrement fixe et ne dépend d'aucune donnée du serveur au rendu. L'historique des
 * audits (cookie) y est donc lu côté client.
 */
export const prerender = true;

/**
 * Action du formulaire natif : un chemin RELATIF sur l'interface elle-même (`/api/discover`),
 * que `astro dev` relaie vers le serveur d'audit local (voir astro.config.mjs).
 *
 * Le flux sans JavaScript reste intact : le navigateur envoie du
 * `application/x-www-form-urlencoded`, le serveur reconnaît ce type de contenu et répond par
 * une redirection 303 vers `/rapport/:jobId`. Il n'y a pas d'étape de sélection, qui
 * demanderait du JavaScript.
 */
const actionApi = routes.decouvrir();

/** Les trois étapes d'un audit, numérotées à la manière du HUD du portfolio. */
const ETAPES = [
	{
		numero: "01",
		titre: "Découverte",
		texte: "Le plan de site est lu, à défaut les liens internes sont suivis.",
	},
	{
		numero: "02",
		titre: "Sélection",
		texte: `Vous choisissez jusqu’à ${PLAFOND_PAGES} pages, et pouvez en ajouter à la main.`,
	},
	{
		numero: "03",
		titre: "Rapport",
		texte: "Lighthouse bureau et mobile, éco-index, page par page, en direct.",
	},
];

const MESURES = [
	{
		icone: "bureau",
		titre: "Bureau et mobile",
		texte: "Deux passages Lighthouse par page : performance, accessibilité, bonnes pratiques et référencement, sur 100.",
	},
	{
		icone: "feuille",
		titre: "Éco-index estimé",
		texte: "Score et note A–G dérivés du DOM, du nombre de requêtes et du poids transféré.",
	},
	{
		icone: "document",
		titre: "Rapport conservé",
		texte: "Chaque audit est enregistré sur votre machine, retrouvable dans « Mes audits » et exportable en JSON.",
	},
];
---

<Layout titre="Auditer un site" large={true} logoAnime={true}>
	{/* ================================================================== héros */}
	<section class="relative">
		<div
			class="apparition flex items-center justify-between border-b filet pb-3 font-mono text-nano tracking-hud-large text-cream-dark uppercase"
		>
			<span>eco-audit // 2026</span>
			<span class="hidden sm:inline">Performance · Accessibilité · Éco-conception</span>
			<span aria-hidden="true">[ + ]</span>
		</div>

		<div class="mx-auto mt-12 max-w-3xl text-center sm:mt-16">
			<h1 class="apparition text-titre-page leading-[1.05]" style="--retard: 80ms">
				Auditez un site,<br />
				<span class="text-cream-dark">une adresse suffit.</span>
			</h1>
			<p class="apparition mx-auto mt-5 max-w-xl text-lg leading-relaxed text-cream-muted" style="--retard: 160ms">
				Les pages sont découvertes pour vous, puis mesurées par Lighthouse en bureau et en
				mobile. Le rapport se construit en direct, page par page.
			</p>
		</div>

		{/* ============================================================ formulaire
		 *
		 * Un seul champ visible. Le nombre de pages n'est plus demandé : il est plafonné à
		 * huit et le choix fin se fait à l'étape suivante, liste sous les yeux —
		 * c'est là qu'il a du sens.
		 *
		 * `novalidate` n'est PAS posé : la validation native du navigateur est le seul filet
		 * disponible quand le JavaScript ne s'exécute pas. `type="text"` + `pattern` tolérant
		 * plutôt que `type="url"`, qui refuse « exemple.fr » — or l'API accepte cette forme et
		 * préfixe elle-même en https://.
		 */}
		<form
			id="formulaire-audit"
			method="post"
			action={actionApi}
			enctype="application/x-www-form-urlencoded"
			class="apparition mx-auto mt-10 max-w-2xl"
			style="--retard: 240ms"
		>
			{/* Valeur fixe, aussi envoyée par le formulaire natif sans JavaScript. */}
			<input type="hidden" name="maxPages" value={PLAFOND_PAGES} />

			<label for="url" class="sr-only">Adresse du site à auditer</label>
			<div
				id="champ-url"
				class="champ-principal flex flex-col gap-2 rounded-[1.75rem] border border-obsidian-border bg-obsidian-card p-2 sm:flex-row sm:items-center sm:rounded-full"
			>
				<div class="flex flex-1 items-center gap-3 pl-3">
					<Icone nom="globe" taille={22} classe="shrink-0 text-primary" />
					<input
						type="text"
						id="url"
						name="url"
						required
						inputmode="url"
						autocomplete="url"
						autocapitalize="off"
						spellcheck="false"
						pattern="^\s*(?:[a-zA-Z][a-zA-Z0-9+.\-]*:\/\/)?[^\s/?#]+\.[^\s/?#]+.*$"
						placeholder="exemple.fr"
						aria-describedby="aide-url erreur-formulaire"
						class="h-12 w-full min-w-0 bg-transparent text-lg outline-none placeholder:text-cream-dark"
					/>
				</div>
				<button type="submit" class="btn btn-primary h-12 gap-2 rounded-full px-6 text-base">
					<Icone nom="loupe" taille={20} />
					<span id="libelle-soumettre">Analyser</span>
				</button>
			</div>

			<p id="aide-url" class="mt-3 text-center text-sm text-cream-dark">
				Le protocole est facultatif : <code class="text-cream-muted">exemple.fr</code> suffit.
			</p>

			{/*
			 * Zone de message d'erreur, SOUS le champ concerné.
			 *
			 * `role="alert"` : un message qui apparaît après une action doit être annoncé sans que
			 * l'utilisateur ait à aller le chercher. Le texte est en `text-echec` (#ff9d9f, ~8,6:1)
			 * et non en carmin : le carmin plafonne à 2,45:1 sur l'obsidian, sous le seuil WCAG AA.
			 */}
			<p id="erreur-formulaire" role="alert" hidden class="mt-3 flex items-start justify-center gap-2 text-sm text-echec">
				<Icone nom="alerte" taille={18} classe="mt-0.5 shrink-0 text-primary" />
				<span id="erreur-formulaire-texte"></span>
			</p>

			<ul class="mt-6 flex flex-wrap justify-center gap-2 text-xs text-cream-muted" aria-label="Limites d’un audit">
				<li class="flex items-center gap-1.5 rounded-full border border-obsidian-border px-3 py-1.5">
					<Icone nom="document" taille={14} classe="text-primary" />
					{PLAFOND_PAGES} pages maximum
				</li>
				<li class="flex items-center gap-1.5 rounded-full border border-obsidian-border px-3 py-1.5">
					<Icone nom="chrono" taille={14} classe="text-primary" />
					~25 s par page
				</li>
				<li class="flex items-center gap-1.5 rounded-full border border-obsidian-border px-3 py-1.5">
					<Icone nom="bouclier" taille={14} classe="text-primary" />
					Rien ne quitte votre machine
				</li>
			</ul>

			{/*
			 * Sans JavaScript, l'étape de sélection n'existe pas : autant le dire ici plutôt que de
			 * laisser l'utilisateur découvrir qu'il a lancé l'audit de tout le site.
			 */}
			<noscript>
				<p class="mt-6 flex items-start gap-2 rounded-box border border-obsidian-border bg-obsidian-card p-4 text-left text-sm text-cream-muted">
					<Icone nom="info" taille={18} classe="mt-0.5 shrink-0 text-primary" />
					<span>
						JavaScript est désactivé : l’audit portera sur <strong class="text-cream">les
						{PLAFOND_PAGES} premières pages découvertes</strong>, sans étape de sélection. Vous
						serez redirigé vers le rapport.
					</span>
				</p>
			</noscript>
		</form>

		<IndicateursSysteme classe="apparition mx-auto mt-10 max-w-2xl [--retard:320ms]" />
	</section>

	{/* ======================================================== derniers audits
	 *
	 * Rempli côté client depuis le cookie `eco_audits` : la page est pré-générée, elle ne voit
	 * pas les cookies au rendu. Masqué tant que l'historique est vide.
	 */}
	<section id="derniers-audits" hidden class="mx-auto mt-14 max-w-2xl" aria-labelledby="titre-derniers-audits">
		<div class="flex items-baseline justify-between gap-3">
			<h2 id="titre-derniers-audits" class="libelle-hud">Vos derniers audits</h2>
			<a href="/mes-audits" class="text-sm text-cream-muted hover:text-cream hover:underline">Tout voir</a>
		</div>
		<ul id="liste-derniers-audits" class="mt-3 divide-y divide-obsidian-border rounded-box border border-obsidian-border bg-obsidian-card"></ul>
	</section>

	{/* ================================================================ étapes */}
	<section class="mt-20" aria-labelledby="titre-etapes">
		<h2 id="titre-etapes" class="sr-only">Comment se déroule un audit</h2>
		<ol class="grid gap-8 sm:grid-cols-3">
			{
				ETAPES.map((etape) => (
					<li class="relative pt-5 before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-obsidian-border after:absolute after:top-0 after:left-0 after:h-px after:w-10 after:bg-crimson-hover">
						<p class="font-mono text-nano tracking-hud-large text-cream-dark uppercase">
							Étape {etape.numero}
						</p>
						<p class="mt-2 font-titre text-xl tracking-wide">{etape.titre}</p>
						<p class="mt-2 text-sm leading-relaxed text-cream-muted">{etape.texte}</p>
					</li>
				))
			}
		</ol>
	</section>

	{/* =============================================================== mesures */}
	<section class="mt-20" aria-labelledby="titre-mesures">
		<h2 id="titre-mesures" class="text-2xl tracking-wide">Ce que mesure un audit</h2>
		<dl class="mt-6 grid gap-4 md:grid-cols-3">
			{
				MESURES.map((mesure) => (
					<div class="rounded-box border border-obsidian-border bg-obsidian-card p-5 transition-colors duration-200 hover:border-cream-dark/40">
						<dt class="flex items-center gap-2.5 font-titre tracking-wide">
							<span class="grid size-9 place-items-center rounded-full bg-primary/15">
								<Icone nom={mesure.icone} taille={18} classe="text-accent" />
							</span>
							{mesure.titre}
						</dt>
						<dd class="mt-3 text-sm leading-relaxed text-cream-muted">{mesure.texte}</dd>
					</div>
				))
			}
		</dl>

		<BandeauEcoindex classe="mt-6" />
	</section>

	{/* Écran d'attente superposé, montré à l'envoi du formulaire. */}
	<Chargeur
		id="chargeur-envoi"
		plein={true}
		titre="Préparation de l’audit"
		phases={["Vérification de l’adresse", "Création de l’audit", "Connexion au site", "Lecture du plan de site"]}
	>
		Vous allez être redirigé vers la liste des pages trouvées.
	</Chargeur>
</Layout>

<script>
	/**
	 * Amélioration progressive du formulaire.
	 *
	 * Le formulaire fonctionne sans ce script : il poste nativement sur l'API, qui redirige en
	 * 303 vers le rapport. Ce script intercepte la soumission pour appeler l'API en JSON, montre
	 * l'écran d'attente, enregistre l'audit dans l'historique du navigateur, puis renvoie vers
	 * `/decouverte/:jobId`.
	 *
	 * Si l'appel échoue pour une raison réseau, le formulaire natif n'est PAS rejoué : cela
	 * doublerait la création de job. On affiche l'erreur et on laisse l'utilisateur réessayer.
	 */
	import { LIBELLE_STATUT, routes } from "../lib/api.js";
	import { PLAFOND_PAGES } from "../lib/identite.js";
	import { abregerCible, enregistrerAudit, lireHistorique } from "../lib/historique.js";

	const formulaire = document.querySelector("#formulaire-audit");
	const champ = document.querySelector("#url");
	const cadreChamp = document.querySelector("#champ-url");
	const bouton = formulaire.querySelector('button[type="submit"]');
	const zoneErreur = document.querySelector("#erreur-formulaire");
	const texteErreur = document.querySelector("#erreur-formulaire-texte");
	const chargeur = document.querySelector("#chargeur-envoi");

	/* ------------------------------------------------ pré-remplissage `?url=` */

	/*
	 * « Relancer cet audit » (page Mes audits, résumé d'un rapport supprimé) arrive ici avec
	 * `?url=exemple.fr` : le champ est pré-rempli, il ne reste qu'à valider.
	 */
	const prerempli = new URLSearchParams(window.location.search).get("url");
	if (prerempli) {
		champ.value = prerempli.slice(0, 2000);
		formulaire.querySelector('button[type="submit"]').focus();
	}

	/* --------------------------------------------------------------- erreurs */

	function afficherErreur(message) {
		texteErreur.textContent = message;
		zoneErreur.hidden = false;
		cadreChamp.dataset.invalide = "";
		champ.setAttribute("aria-invalid", "true");
	}

	function masquerErreur() {
		zoneErreur.hidden = true;
		texteErreur.textContent = "";
		delete cadreChamp.dataset.invalide;
		champ.removeAttribute("aria-invalid");
	}

	// L'erreur disparaît dès que l'utilisateur corrige : elle ne doit pas lui survivre.
	champ.addEventListener("input", masquerErreur);

	function verrouiller(verrouille) {
		bouton.disabled = verrouille;
		// `aria-busy` sur le formulaire : l'attente est annoncée, pas seulement dessinée.
		formulaire.setAttribute("aria-busy", String(verrouille));
		chargeur.hidden = !verrouille;
	}

	/* -------------------------------------------------------------- envoi */

	formulaire.addEventListener("submit", async (evenement) => {
		// La validation native a déjà tourné : si elle avait échoué, `submit` ne serait pas émis.
		evenement.preventDefault();
		masquerErreur();

		const url = champ.value.trim();
		verrouiller(true);

		try {
			const reponse = await fetch(routes.decouvrir(), {
				method: "POST",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify({ url, maxPages: PLAFOND_PAGES }),
			});

			const corps = await reponse.json().catch(() => null);

			if (!reponse.ok) {
				verrouiller(false);
				afficherErreur(corps?.error || `Le service a refusé la demande (erreur ${reponse.status}).`);
				champ.focus();
				return;
			}

			// L'audit est rattaché à ce navigateur dès sa création : voir `lib/historique.js`.
			enregistrerAudit({
				i: Number(corps.jobId),
				u: abregerCible(corps.url || url),
				t: Date.now(),
				v: Date.now(),
				s: "discovering",
			});

			/*
			 * `replace` et non `assign` : le retour arrière depuis la page de sélection doit ramener
			 * au formulaire, pas le resoumettre. L'écran d'attente reste affiché jusqu'au
			 * changement de page, où la découverte prend le relais avec le même chargeur.
			 */
			window.location.replace(`/decouverte/${corps.jobId}`);
		} catch {
			verrouiller(false);
			afficherErreur("Le serveur d’audit local est injoignable. Vérifiez que « npm run dev » tourne toujours, puis réessayez.");
		}
	});

	/*
	 * Retour arrière vers cette page depuis le cache de navigation (bfcache) : le chargeur
	 * serait resté affiché, figé sur l'état d'avant le départ.
	 */
	window.addEventListener("pageshow", (evenement) => {
		if (evenement.persisted) verrouiller(false);
	});

	/* ----------------------------------------------------- derniers audits */

	const historique = lireHistorique();
	if (historique.length > 0) {
		const liste = document.querySelector("#liste-derniers-audits");
		liste.replaceChildren(
			...historique.slice(0, 3).map((entree) => {
				const ligne = document.createElement("li");
				const lien = document.createElement("a");
				lien.href = `/rapport/${entree.i}`;
				lien.className =
					"flex items-center justify-between gap-4 px-4 py-3 transition-colors duration-200 hover:bg-obsidian-hover";

				const gauche = document.createElement("span");
				gauche.className = "min-w-0";
				const cible = document.createElement("span");
				cible.className = "block truncate text-sm text-cream";
				cible.textContent = entree.u || `Audit n° ${entree.i}`;
				const date = document.createElement("span");
				date.className = "block text-xs text-cream-dark";
				date.textContent = new Intl.DateTimeFormat("fr-FR", {
					dateStyle: "medium",
					timeStyle: "short",
				}).format(entree.t);
				gauche.append(cible, date);

				const etat = document.createElement("span");
				const termine = entree.s === "done";
				etat.className = `shrink-0 text-xs ${termine ? "text-ok" : "text-cream-dark"}`;
				etat.textContent = entree.s ? (LIBELLE_STATUT[entree.s] ?? entree.s) : "Statut inconnu";

				lien.append(gauche, etat);
				ligne.append(lien);
				return ligne;
			}),
		);
		document.querySelector("#derniers-audits").hidden = false;
	}
</script>
