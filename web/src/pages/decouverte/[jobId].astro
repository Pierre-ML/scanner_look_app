---
import Layout from "../../layouts/Layout.astro";
import Icone from "../../components/Icone.astro";
import AuditIndisponible from "../../components/AuditIndisponible.astro";
import Chargeur from "../../components/Chargeur.astro";
import { routesServeur, chargerEtatInitial } from "../../lib/api-serveur.js";
import { PLAFOND_PAGES } from "../../lib/identite.js";

/**
 * Sélection des pages à auditer — `/decouverte/[jobId]`, RENDUE À LA DEMANDE.
 *
 * Même raison que pour le rapport : un jobId naît après le déploiement, `getStaticPaths` ne
 * peut pas l'énumérer au build.
 *
 * L'étape elle-même reste tributaire du JavaScript : cocher une liste puis poster un tableau
 * JSON n'a pas d'équivalent en HTML natif. Le rendu serveur apporte deux choses malgré tout :
 *   - les pages découvertes voyagent avec le document, donc la liste s'affiche sans
 *     aller-retour et sans écran d'attente quand la découverte est déjà finie ;
 *   - le numéro du job est connu du serveur, ce qui rend enfin possible la redirection sans
 *     JavaScript vers `/rapport/:jobId` — impossible en pré-généré, où le document ne savait
 *     pas de quel job il parlait.
 */
export const prerender = false;

const { jobId } = Astro.params;

/** État de la découverte, avant le rendu du HTML. Adresse directe du serveur d'audit. */
const decouverteInitiale = await chargerEtatInitial(routesServeur.decouverte(jobId));

/* Job inexistant ou supprimé : la page répond elle-même en 404, comme le rapport. */
const introuvable = decouverteInitiale.cas === "introuvable";
if (introuvable) {
	Astro.response.status = 404;
}

/* Jamais de cache : la découverte est un état vivant, comme l'avancement d'un audit. */
Astro.response.headers.set("cache-control", "no-store, no-cache, must-revalidate, max-age=0");
Astro.response.headers.set("pragma", "no-cache");

const etat = decouverteInitiale.cas === "ok" ? decouverteInitiale.donnees : null;

const donneesInitiales = {
	jobId,
	etat,
	rapport: null,
	indisponible: decouverteInitiale.cas === "indisponible" ? decouverteInitiale.message : null,
};

/**
 * L'audit est-il déjà lancé ? Il n'y a alors plus rien à sélectionner, et la page doit
 * conduire au rapport. Redirection côté serveur : immédiate, et valable sans JavaScript.
 */
const dejaLance = ["queued", "running", "done", "stopped"].includes(etat?.status);
if (dejaLance) {
	return Astro.redirect(`/rapport/${jobId}`, 303);
}

/*
 * La liste des pages n'est volontairement PAS rendue en HTML côté serveur.
 *
 * Elle ne serait utile à personne : le bloc applicatif est masqué sans JavaScript (ses cases
 * et ses boutons n'aboutiraient à rien), et un visiteur sans JavaScript est redirigé vers le
 * rapport. La rendre deux fois — une fois en Astro, une fois dans `creerLigne` — créerait deux
 * chemins de rendu à garder synchronisés, pour un gain nul.
 *
 * Ce que le rendu serveur apporte ici est ailleurs : les données voyagent dans
 * `#donnees-initiales`, et le script construit la liste dès le chargement, sans l'aller-retour
 * réseau qui affichait auparavant « Découverte en cours… » même sur une découverte terminée.
 */
---

{
	introuvable ? (
		<Layout titre="Audit introuvable" sansCache={true}>
			<AuditIndisponible numero={jobId} />
		</Layout>
	) : (
<Layout titre="Sélection des pages" sansCache={true}>
	{/* État initial pour le script client : texte inerte, jamais exécuté. */}
	<script
		is:inline
		type="application/json"
		id="donnees-initiales"
		set:html={JSON.stringify(donneesInitiales).replaceAll("<", "\\u003c")}
	/>

	{/*
	 * Comportement dégradé sans JavaScript : redirection directe vers le rapport.
	 *
	 * Le `<meta http-equiv="refresh">` dans un `<noscript>` n'est suivi que si le JavaScript
	 * est indisponible — c'est le seul moyen de rediriger en HTML pur. Il est désormais
	 * écrivable parce que le serveur connaît le numéro du job : en pré-généré, le document ne
	 * savait pas de quel audit il parlait et cette redirection était impossible.
	 *
	 * Le lien qui suit couvre les rares navigateurs où le rafraîchissement est bloqué.
	 */}
	<noscript>
		<meta http-equiv="refresh" content={`0; url=/rapport/${jobId}`} />
		<p class="flex items-start gap-2 rounded-box border border-obsidian-border bg-obsidian-card p-4 text-sm text-cream-muted">
			<Icone nom="info" taille={18} classe="mt-0.5 shrink-0 text-primary" />
			<span>
				JavaScript est désactivé : la sélection des pages n’est pas possible, vous êtes
				redirigé vers le rapport.
				<a href={`/rapport/${jobId}`} class="text-cream underline">Continuer vers le rapport</a>.
			</span>
		</p>
	</noscript>

	{/*
	 * Toujours masqué au départ, contrairement à la page de rapport : ce bloc contient des
	 * cases à cocher et des boutons qui n'aboutissent à rien sans JavaScript. Les montrer à un
	 * utilisateur qui ne peut pas s'en servir serait un piège — d'où le `hidden`, levé par le
	 * script, tandis que le `<noscript>` ci-dessus le mène au rapport.
	 */}
	<div id="application" hidden>
		<header>
			<p class="libelle-hud flex items-center gap-2">
				<Icone nom="radar" taille={18} classe="text-primary" />
				Étape 2 sur 3 · Sélection
			</p>
			<h1 class="mt-3 text-titre-page leading-tight">Quelles pages auditer ?</h1>
			<p class="mt-3 text-cream-muted">
				Site cible :{" "}
				<span id="cible" class="text-cream">…</span>
			</p>
		</header>

		{/* ------------------------------------------------ découverte en cours
		 *
		 * Même chargeur que celui de l'accueil : l'utilisateur qui vient de valider le formulaire
		 * voit la même animation se poursuivre, sans rupture d'une page à l'autre. Le composant
		 * porte déjà son `role="status"` : la phase en cours est annoncée, poliment.
		 */}
		<Chargeur
			id="etat-attente"
			classe="mt-8"
			titre="Découverte des pages"
			phases={["Connexion au site", "Lecture du plan de site", "Suivi des liens internes", "Tri des pages trouvées"]}
		>
			Le plan de site est lu en premier ; à défaut, les liens internes sont suivis.
		</Chargeur>

		{/* ------------------------------------------------------ liste et choix */}
		<section id="etat-liste" hidden class="mt-8">
			<div class="flex flex-wrap items-baseline justify-between gap-3 border-b filet pb-3">
				<h2 class="text-xl tracking-wide">
					Pages découvertes
					<span id="compteur-decouvertes" class="text-cream-dark"></span>
				</h2>
				<div class="flex gap-2">
					<button type="button" id="tout-cocher" class="btn btn-sm btn-ghost">Tout cocher</button>
					<button type="button" id="tout-decocher" class="btn btn-sm btn-ghost">
						Tout décocher
					</button>
				</div>
			</div>

			{/*
			 * `<fieldset>` + `<legend>` : sans eux, un lecteur d'écran annonce une suite de cases
			 * sans dire de quoi elles relèvent. La légende est masquée visuellement (le `<h2>`
			 * au-dessus joue ce rôle à l'œil) mais reste lue.
			 */}
			<fieldset class="mt-4">
				<legend class="sr-only">Pages à inclure dans l’audit</legend>
				<ul id="liste-pages" class="divide-y divide-obsidian-border"></ul>
			</fieldset>

			{/* ------------------------------------------- ajout manuel */}
			<div class="mt-6 rounded-box border border-obsidian-border bg-obsidian-card p-5">
				<h3 class="font-titre tracking-wide">Ajouter une page à la main</h3>
				{/*
				 * Le champ ne doit pas laisser croire qu'on peut scanner un autre domaine : le
				 * préfixe de l'origine est affiché en clair et n'est pas modifiable, on ne saisit
				 * que le chemin. La validation côté client complète cet indice visuel — et l'API
				 * revalide de son côté (même origine que la cible, sinon 400).
				 */}
				<p id="aide-ajout" class="mt-1 text-sm text-cream-muted">
					Uniquement sur le site audité : seul le chemin est saisissable.
				</p>

				<div class="mt-3 flex flex-col gap-2 sm:flex-row">
					<label for="chemin-manuel" class="sr-only">Chemin de la page à ajouter</label>
					<div class="flex flex-1 items-center rounded-field border border-obsidian-border bg-base-100 px-3 focus-within:border-cream-dark">
						<span id="prefixe-origine" class="shrink-0 select-none py-3 text-sm text-cream-dark"></span>
						<input
							type="text"
							id="chemin-manuel"
							placeholder="/contact"
							spellcheck="false"
							autocomplete="off"
							aria-describedby="aide-ajout"
							class="w-full bg-transparent py-3 outline-none placeholder:text-cream-dark"
						/>
					</div>
					<button type="button" id="ajouter-page" class="btn btn-secondary gap-2">
						<Icone nom="plus" taille={18} />
						Ajouter
					</button>
				</div>

				<p id="erreur-ajout" role="alert" hidden class="mt-3 flex items-start gap-2 text-sm text-echec">
					<Icone nom="alerte" taille={18} classe="mt-0.5 shrink-0 text-primary" />
					<span id="erreur-ajout-texte"></span>
				</p>
			</div>

			{/* ------------------------------------------------- lancement */}
			<div class="mt-8 flex flex-col gap-4 border-t filet pt-6">
				<p class="text-sm text-cream-muted" aria-live="polite">
					<span id="resume-selection">Aucune page sélectionnée.</span>
					<span class="text-cream-dark">
						Plafond : {PLAFOND_PAGES} pages par audit. Environ 25 secondes par page.
					</span>
					<span id="plafond-atteint" hidden class="mt-1 block text-alerte">
						Plafond de {PLAFOND_PAGES} pages atteint : décochez une page pour en choisir une autre.
					</span>
				</p>

				<p id="erreur-lancement" role="alert" hidden class="flex items-start gap-2 text-sm text-echec">
					<Icone nom="alerte" taille={18} classe="mt-0.5 shrink-0 text-primary" />
					<span id="erreur-lancement-texte"></span>
				</p>

				<div class="flex flex-wrap gap-3">
					<button type="button" id="lancer-audit" class="btn btn-primary gap-2">
						<Icone nom="fleche" taille={20} />
						<span id="libelle-lancer">Lancer l’audit</span>
					</button>
					<a href="/" class="btn btn-ghost gap-2">
						<Icone nom="retour" taille={20} />
						Changer de site
					</a>
				</div>
			</div>
		</section>

		{/* ----------------------------------------------------------- erreurs */}
		<section id="etat-erreur" hidden class="mt-8 rounded-box border border-obsidian-border bg-obsidian-card p-6">
			<h2 class="flex items-center gap-2.5 text-xl tracking-wide">
				<Icone nom="alerte" taille={22} classe="text-primary" />
				<span id="titre-erreur">Audit impossible</span>
			</h2>
			{/* Texte d'état en `text-echec` : conforme AA, contrairement au carmin. */}
			<p id="message-erreur" class="mt-3 text-echec"></p>
			<p id="detail-erreur" class="mt-3 text-cream-muted"></p>
			<p class="mt-6 flex flex-wrap gap-3">
				<a href="/" class="btn btn-primary gap-2">
					<Icone nom="retour" taille={20} />
					Revenir au formulaire
				</a>
				<button type="button" id="reessayer" class="btn btn-ghost">Réessayer</button>
			</p>
		</section>
	</div>
</Layout>
	)
}

<script>
	import { routes } from "../../lib/api.js";
	import { PLAFOND_PAGES } from "../../lib/identite.js";
	import { abregerCible, enregistrerAudit } from "../../lib/historique.js";
	import {
		abregerUrl,
		appeler,
		creerPolling,
		lireDonneesInitiales,
		lireJobId,
	} from "../../scripts/job.js";

	/*
	 * L'interface est masquée dans le HTML (`hidden` sur #application) et révélée ici : c'est ce
	 * qui garantit que l'utilisateur sans JavaScript voit le bloc <noscript> et RIEN d'autre,
	 * plutôt qu'un écran de chargement qui ne finira jamais.
	 */
	const application = document.querySelector("#application");
	application.hidden = false;

	/** État déjà obtenu par le serveur : évite le premier aller-retour. */
	const initiales = lireDonneesInitiales();
	const jobId = lireJobId();

	/** Panneaux d'état, exclusifs les uns des autres. */
	const panneaux = {
		attente: document.querySelector("#etat-attente"),
		liste: document.querySelector("#etat-liste"),
		erreur: document.querySelector("#etat-erreur"),
	};

	function montrer(nom) {
		for (const [cle, element] of Object.entries(panneaux)) {
			element.hidden = cle !== nom;
		}
	}

	/*
	 * Le chargeur est rendu masqué (voir `Chargeur.astro`) : on part donc explicitement sur
	 * l'écran d'attente. Si la découverte est déjà finie, l'hydratation bascule sur la liste
	 * dans la foulée, avant le premier affichage.
	 */
	montrer("attente");

	/**
	 * Affiche une erreur. `introuvable` reçoit l'explication : un audit absent a été effacé
	 * (depuis « Mes audits » ou en vidant `data/`), le dire évite à l'utilisateur de chercher
	 * ce qu'il a mal fait.
	 */
	function echouer(genre, message) {
		const titre = document.querySelector("#titre-erreur");
		const detail = document.querySelector("#detail-erreur");

		if (genre === "introuvable") {
			titre.textContent = "Audit introuvable";
			detail.textContent =
				"Cet audit n’existe pas sur cette machine : il a sans doute été effacé depuis " +
				"« Mes audits », ou le dossier data/ a été vidé. Relancez-le depuis le formulaire.";
		} else if (genre === "reseau") {
			titre.textContent = "Serveur injoignable";
			detail.textContent =
				"Le serveur d’audit local ne répond pas. Vérifiez que « npm run dev » tourne " +
				"toujours : l’audit n’est pas perdu pour autant.";
		} else {
			titre.textContent = "Audit impossible";
			detail.textContent = "";
		}

		document.querySelector("#message-erreur").textContent = message;
		montrer("erreur");
	}

	document.querySelector("#reessayer").addEventListener("click", () => {
		window.location.reload();
	});

	if (!jobId) {
		echouer("introuvable", "Aucun numéro d’audit dans l’adresse de cette page.");
	} else {
		demarrer(jobId);
	}

	/* ==================================================================== */

	function demarrer(id) {
		/** Origine de la cible, servie de garde-fou à l'ajout manuel. */
		let origine = null;

		const liste = document.querySelector("#liste-pages");
		const resume = document.querySelector("#resume-selection");
		const boutonLancer = document.querySelector("#lancer-audit");

		/*
		 * Poll de la découverte. L'API expose `ready` : vrai dès que des pages sont proposées et
		 * que le statut a quitté `discovering`. On ne recalcule pas cette condition côté client.
		 */
		/**
		 * Applique un état de découverte à la page.
		 *
		 * Utilisé à l'identique par l'hydratation initiale et par chaque tour de polling : un
		 * seul chemin de rendu, donc aucun risque que le premier affichage diverge des suivants.
		 *
		 * @returns {boolean} `true` pour continuer à interroger l'API.
		 */
		function appliquerEtat(etat) {
			document.querySelector("#cible").textContent = abregerUrl(etat.targetUrl, 80);
			enregistrerAudit({ i: Number(id), u: abregerCible(etat.targetUrl), s: etat.status, v: Date.now() });

			// La découverte a échoué côté serveur : inutile de continuer à interroger.
			if (etat.status === "error") {
				echouer("refus", etat.error || "La découverte des pages a échoué.");
				return false;
			}

			/*
			 * L'audit a déjà été lancé (second onglet, ou lancement survenu pendant que la page
			 * était ouverte) : il n'y a plus rien à sélectionner, on va droit au rapport. Au
			 * premier rendu, ce cas est déjà traité par une redirection 303 côté serveur.
			 */
			if (["queued", "running", "done", "stopped"].includes(etat.status)) {
				window.location.replace(`/rapport/${id}`);
				return false;
			}

			// Découverte encore en cours : on garde l'écran d'attente et on repasse dans 2 s.
			if (!etat.ready) return true;

			origine = lireOrigine(etat.targetUrl);
			afficherPages(etat.discoveredUrls, etat.maxPages);
			montrer("liste");
			return false;
		}

		/*
		 * Hydratation : le serveur a déjà interrogé l'API pendant le rendu de la page. Quand la
		 * découverte était terminée, la liste s'affiche donc immédiatement, et aucun polling
		 * n'est même ouvert — c'est le cas courant, la découverte étant bien plus rapide qu'un
		 * audit.
		 *
		 * Quand le serveur n'a rien obtenu (API momentanément muette), `etatHydrate` reste faux
		 * et le polling garde son premier appel immédiat : l'écran d'attente ne doit pas durer
		 * deux secondes de plus que nécessaire.
		 */
		let etatHydrate = false;
		if (initiales.etat) {
			etatHydrate = true;
			if (appliquerEtat(initiales.etat) === false) return;
		}

		const polling = creerPolling(async () => {
			try {
				return appliquerEtat(await appeler(routes.decouverte(id)));
			} catch (erreur) {
				echouer(erreur.genre, erreur.message);
				return false;
			}
		}, 2000, { immediat: !etatHydrate });

		/* -------------------------------------------------- rendu de la liste */

		function afficherPages(urls, maxPages) {
			document.querySelector("#compteur-decouvertes").textContent = `(${urls.length})`;
			document.querySelector("#prefixe-origine").textContent = origine ?? "";

			/*
			 * Les {PLAFOND_PAGES} premières pages sont cochées d'office : c'est l'ordre du plan de
			 * site (ou de la découverte), donc en général l'accueil et les pages principales.
			 */
			liste.replaceChildren(...urls.map((url, rang) => creerLigne(url, false, rang < PLAFOND_PAGES)));
			rafraichirResume();
		}

		/**
		 * Une ligne = une case à cocher CARRÉE (jamais ronde : un rond se lit comme un bouton
		 * radio, or ces choix sont cumulables) et l'URL complète, sélectionnable.
		 */
		function creerLigne(url, ajoutee = false, cochee = true) {
			const element = document.createElement("li");
			element.className = "flex items-start gap-3 py-3 transition-opacity duration-200 has-[:disabled]:opacity-50";

			const case_ = document.createElement("input");
			case_.type = "checkbox";
			case_.className = "checkbox checkbox-primary mt-0.5 shrink-0";
			case_.checked = cochee;
			case_.value = url;
			case_.id = `page-${liste.children.length}-${Date.now()}`;
			case_.addEventListener("change", () => rafraichirResume());

			const etiquette = document.createElement("label");
			etiquette.htmlFor = case_.id;
			etiquette.className = "min-w-0 flex-1 cursor-pointer";

			const texte = document.createElement("span");
			texte.className = "block break-all text-sm";
			texte.textContent = url;
			etiquette.append(texte);

			if (ajoutee) {
				const marque = document.createElement("span");
				marque.className = "libelle-hud mt-1 block";
				marque.textContent = "Ajoutée manuellement";
				etiquette.append(marque);
			}

			element.append(case_, etiquette);
			return element;
		}

		/** Les cases cochées, dans l'ordre d'affichage. */
		function selection() {
			return [...liste.querySelectorAll('input[type="checkbox"]:checked')].map((c) => c.value);
		}

		/**
		 * Met à jour le résumé et fait respecter le plafond : une fois {PLAFOND_PAGES} pages
		 * cochées, les cases restantes sont désactivées. L'API applique le même plafond de son
		 * côté ; le faire ici évite seulement une erreur au lancement.
		 */
		function rafraichirResume() {
			const nombre = selection().length;
			const plein = nombre >= PLAFOND_PAGES;

			liste.querySelectorAll('input[type="checkbox"]').forEach((c) => {
				c.disabled = plein && !c.checked;
			});
			document.querySelector("#plafond-atteint").hidden = !plein;

			resume.textContent =
				nombre === 0
					? "Aucune page sélectionnée."
					: `${nombre}/${PLAFOND_PAGES} page${nombre > 1 ? "s" : ""} sélectionnée${nombre > 1 ? "s" : ""}.`;
			boutonLancer.disabled = nombre === 0;
		}

		// « Tout cocher » s'arrête au plafond, dans l'ordre d'affichage.
		document.querySelector("#tout-cocher").addEventListener("click", () => {
			let restantes = PLAFOND_PAGES - selection().length;
			liste.querySelectorAll('input[type="checkbox"]:not(:checked)').forEach((c) => {
				if (restantes > 0) {
					c.checked = true;
					restantes -= 1;
				}
			});
			rafraichirResume();
		});

		document.querySelector("#tout-decocher").addEventListener("click", () => {
			liste.querySelectorAll('input[type="checkbox"]').forEach((c) => (c.checked = false));
			rafraichirResume();
		});

		/* ------------------------------------------------------ ajout manuel */

		const champ = document.querySelector("#chemin-manuel");
		const zoneErreurAjout = document.querySelector("#erreur-ajout");
		const texteErreurAjout = document.querySelector("#erreur-ajout-texte");

		function erreurAjout(message) {
			texteErreurAjout.textContent = message;
			zoneErreurAjout.hidden = false;
		}

		function ajouter() {
			zoneErreurAjout.hidden = true;
			const saisie = champ.value.trim();

			if (saisie === "") {
				erreurAjout("Indiquez le chemin de la page à ajouter, par exemple /contact.");
				return;
			}

			/*
			 * Validation côté client. Elle sert de retour immédiat, pas de sécurité : l'API
			 * revalide chaque URL (même origine que la cible, sinon refus 400). Une saisie
			 * absolue est acceptée si — et seulement si — elle vise la même origine ; dans tous
			 * les autres cas elle est résolue comme un chemin relatif à la cible, ce qui rend
			 * impossible de viser un autre domaine par accident.
			 */
			let candidate;
			try {
				candidate = new URL(saisie, origine);
			} catch {
				erreurAjout("Chemin invalide.");
				return;
			}

			if (candidate.origin !== origine) {
				erreurAjout(
					`Un audit ne peut porter que sur ${origine} : les pages d’un autre domaine sont refusées.`,
				);
				return;
			}

			// Le fragment n'a aucun sens pour un audit de page, l'API le retire de son côté.
			candidate.hash = "";
			const url = candidate.toString();

			const deja = [...liste.querySelectorAll('input[type="checkbox"]')].find(
				(c) => c.value === url,
			);
			if (deja) {
				// Plutôt qu'un doublon : on recoche la ligne existante (dans la limite du plafond).
				if (!deja.checked && selection().length < PLAFOND_PAGES) deja.checked = true;
				deja.closest("li")?.scrollIntoView({ block: "nearest" });
				erreurAjout("Cette page figurait déjà dans la liste : elle a été cochée.");
				champ.value = "";
				rafraichirResume();
				return;
			}

			const place = selection().length < PLAFOND_PAGES;
			liste.append(creerLigne(url, true, place));
			if (!place) {
				erreurAjout(
					`Page ajoutée, mais non cochée : le plafond de ${PLAFOND_PAGES} pages est atteint.`,
				);
			}
			champ.value = "";
			rafraichirResume();
			champ.focus();
		}

		document.querySelector("#ajouter-page").addEventListener("click", ajouter);

		// Entrée dans le champ ajoute la page, sans soumettre quoi que ce soit.
		champ.addEventListener("keydown", (evenement) => {
			if (evenement.key === "Enter") {
				evenement.preventDefault();
				ajouter();
			}
		});

		/* --------------------------------------------------------- lancement */

		const libelleLancer = document.querySelector("#libelle-lancer");
		const zoneErreurLancement = document.querySelector("#erreur-lancement");
		const texteErreurLancement = document.querySelector("#erreur-lancement-texte");

		boutonLancer.addEventListener("click", async () => {
			zoneErreurLancement.hidden = true;
			const urls = selection();

			if (urls.length === 0) {
				texteErreurLancement.textContent = "Sélectionnez au moins une page à auditer.";
				zoneErreurLancement.hidden = false;
				return;
			}

			boutonLancer.disabled = true;
			libelleLancer.textContent = "Lancement…";

			try {
				/*
				 * Refus possibles, affichés tels quels sous le bouton : un autre audit tourne déjà
				 * (409 avec `auditEnCours`), ou aucun navigateur n'a été trouvé (503, avec la
				 * marche à suivre).
				 */
				await appeler(routes.auditer(id), {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ selectedUrls: urls }),
				});

				enregistrerAudit({ i: Number(id), s: "running", n: urls.length, v: Date.now() });
				polling.stop();
				window.location.replace(`/rapport/${id}`);
			} catch (erreur) {
				/*
				 * 409 : le job n'est plus en attente de validation — le plus souvent un double
				 * clic, ou un audit déjà lancé depuis un autre onglet. Le rapport est alors la
				 * bonne destination, et non un message d'erreur.
				 *
				 * Exception : 409 avec `auditEnCours`, c'est un AUTRE audit qui occupe Chrome (un
				 * seul à la fois). Ce job-ci attend toujours : on affiche le message, sélection
				 * intacte, pour relancer une fois l'autre terminé.
				 */
				if (erreur.statut === 409 && !erreur.corps?.auditEnCours) {
					polling.stop();
					window.location.replace(`/rapport/${id}`);
					return;
				}

				if (erreur.genre === "introuvable") {
					echouer("introuvable", erreur.message);
					return;
				}

				boutonLancer.disabled = false;
				libelleLancer.textContent = "Lancer l’audit";
				texteErreurLancement.textContent = erreur.message;
				zoneErreurLancement.hidden = false;
			}
		});
	}

	/** Origine d'une URL cible, ou `null` si elle est illisible. */
	function lireOrigine(url) {
		try {
			return new URL(url).origin;
		} catch {
			return null;
		}
	}
</script>
