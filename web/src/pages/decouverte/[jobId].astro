---
import Layout from "../../layouts/Layout.astro";
import Icone from "../../components/Icone.astro";
import AuditIndisponible from "../../components/AuditIndisponible.astro";
import Chargeur from "../../components/Chargeur.astro";
import ChoixMode from "../../components/ChoixMode.astro";
import { routesServeur, chargerEtatInitial } from "../../lib/api-serveur.js";

/** Sélection des pages à auditer — `/decouverte/[jobId]`, RENDUE À LA DEMANDE. */
export const prerender = false;

const { jobId } = Astro.params;

/** État de la découverte, avant le rendu du HTML. */
const decouverteInitiale = await chargerEtatInitial(routesServeur.decouverte(jobId));

/* Job inexistant ou supprimé : la page répond elle-même en 404, comme le rapport. */
const introuvable = decouverteInitiale.cas === "introuvable";
if (introuvable) {
	Astro.response.status = 404;
}

/* Jamais de cache : la découverte est un état vivant, comme l'avancement d'un audit. */
Astro.response.headers.set("cache-control", "no-store, no-cache, must-revalidate, max-age=0");
Astro.response.headers.set("pragma", "no-cache");

const etat = decouverteInitiale.cas === "ok" ? decouverteInitiale.donnees : null;

const donneesInitiales = {
	jobId,
	etat,
	rapport: null,
	indisponible: decouverteInitiale.cas === "indisponible" ? decouverteInitiale.message : null,
};

/** L'audit est-il déjà lancé ? */
const dejaLance = ["queued", "running", "done", "stopped"].includes(etat?.status);
if (dejaLance) {
	return Astro.redirect(`/rapport/${jobId}`, 303);
}

/* La liste des pages n'est volontairement PAS rendue en HTML côté serveur. */
---

{
	introuvable ? (
		<Layout titre="Audit introuvable" sansCache={true}>
			<AuditIndisponible numero={jobId} />
		</Layout>
	) : (
<Layout titre="Sélection des pages" sansCache={true}>
	{/* État initial pour le script client : texte inerte, jamais exécuté. */}
	<script
		is:inline
		type="application/json"
		id="donnees-initiales"
		set:html={JSON.stringify(donneesInitiales).replaceAll("<", "\\u003c")}
	/>

	{/* Comportement dégradé sans JavaScript : redirection directe vers le rapport. */}
	<noscript>
		<meta http-equiv="refresh" content={`0; url=/rapport/${jobId}`} />
		<p class="flex items-start gap-2 rounded-box border border-obsidian-border bg-obsidian-card p-4 text-sm text-cream-muted">
			<Icone nom="info" taille={18} classe="mt-0.5 shrink-0 text-primary" />
			<span>
				JavaScript est désactivé : la sélection des pages n’est pas possible, vous êtes
				redirigé vers le rapport.
				<a href={`/rapport/${jobId}`} class="text-cream underline">Continuer vers le rapport</a>.
			</span>
		</p>
	</noscript>

	{/* Toujours masqué au départ, contrairement à la page de rapport : ce bloc contient des cases à
	    cocher et des boutons qui n'aboutissent à rien sans JavaScript. */}
	<div id="application" hidden>
		<header>
			<p class="font-corps text-micro tracking-hud uppercase text-cream-dark flex items-center gap-2">
				<Icone nom="radar" taille={18} classe="text-primary" />
				Étape 2 sur 3 · Sélection
			</p>
			<h1 class="font-titre tracking-[0.02em] mt-3 text-titre-page leading-tight">Quelles pages auditer ?</h1>
			<p class="mt-3 text-cream-muted">
				Site cible :{" "}
				<span id="cible" class="text-cream">…</span>
			</p>
		</header>

		{/* découverte en cours */}
		<Chargeur
			id="etat-attente"
			classe="mt-8"
			titre="Découverte des pages"
			phases={["Connexion au site", "Lecture du plan de site", "Suivi des liens internes", "Tri des pages trouvées"]}
		>
			Le plan de site est lu en premier ; à défaut, les liens internes sont suivis.
		</Chargeur>

		{/* liste et choix */}
		<section id="etat-liste" hidden class="mt-8">
			<div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-obsidian-border pb-3">
				<h2 class="font-titre tracking-[0.02em] text-xl">
					Pages découvertes
					<span id="compteur-decouvertes" class="text-cream-dark"></span>
				</h2>
				<div class="flex gap-2">
					<button type="button" id="tout-cocher" class="btn btn-sm btn-ghost">Tout cocher</button>
					<button type="button" id="tout-decocher" class="btn btn-sm btn-ghost">
						Tout décocher
					</button>
				</div>
			</div>

			{/* `<fieldset>` + `<legend>` : sans eux, un lecteur d'écran annonce une suite de cases sans dire
			    de quoi elles relèvent. */}
			<fieldset class="mt-4">
				<legend class="sr-only">Pages à inclure dans l’audit</legend>
				<ul id="liste-pages" class="divide-y divide-obsidian-border"></ul>
			</fieldset>

			{/* ajout manuel */}
			<div class="mt-6 rounded-box border border-obsidian-border bg-obsidian-card p-5">
				<h3 class="font-titre tracking-[0.02em]">Ajouter une page à la main</h3>
				{/* Le champ ne doit pas laisser croire qu'on peut scanner un autre domaine : le préfixe de
				    l'origine est affiché en clair et n'est pas modifiable, on ne saisit que le chemin. */}
				<p id="aide-ajout" class="mt-1 text-sm text-cream-muted">
					Uniquement sur le site audité : seul le chemin est saisissable.
				</p>

				<div class="mt-3 flex flex-col gap-2 sm:flex-row">
					<label for="chemin-manuel" class="sr-only">Chemin de la page à ajouter</label>
					<div class="flex flex-1 items-center rounded-field border border-obsidian-border bg-base-100 px-3 focus-within:border-cream-dark">
						<span id="prefixe-origine" class="shrink-0 select-none py-3 text-sm text-cream-dark"></span>
						<input
							type="text"
							id="chemin-manuel"
							placeholder="/contact"
							spellcheck="false"
							autocomplete="off"
							aria-describedby="aide-ajout"
							class="w-full bg-transparent py-3 outline-none placeholder:text-cream-dark"
						/>
					</div>
					<button type="button" id="ajouter-page" class="btn btn-secondary gap-2">
						<Icone nom="plus" taille={18} />
						Ajouter
					</button>
				</div>

				<p id="erreur-ajout" role="alert" hidden class="mt-3 flex items-start gap-2 text-sm text-echec">
					<Icone nom="alerte" taille={18} classe="mt-0.5 shrink-0 text-primary" />
					<span id="erreur-ajout-texte"></span>
				</p>
			</div>

			{/* lancement */}
			<div class="mt-8 flex flex-col gap-4 border-t border-obsidian-border pt-6">
				<ChoixMode />

				<p class="text-sm text-cream-muted" aria-live="polite">
					<span id="resume-selection">Aucune page sélectionnée.</span>{" "}
					<span class="text-cream-dark">
						Pas de limite de pages. Environ 25 secondes par page.
					</span>
					{/* Avertissement, pas interdiction : au-delà de SEUIL_AUDIT_LONG pages cochées, l'audit se
					    compte en dizaines de minutes. */}
					<span id="avertissement-long" hidden class="mt-1 block text-alerte"></span>
				</p>

				<p id="erreur-lancement" role="alert" hidden class="flex items-start gap-2 text-sm text-echec">
					<Icone nom="alerte" taille={18} classe="mt-0.5 shrink-0 text-primary" />
					<span id="erreur-lancement-texte"></span>
				</p>

				{/* Retour à gauche, action principale à droite. */}
				<div class="flex flex-wrap items-center justify-between gap-3">
					<a href="/" class="btn btn-ghost gap-2">
						<Icone nom="retour" taille={20} />
						Changer de site
					</a>
					<button type="button" id="lancer-audit" class="btn btn-primary gap-2">
						<Icone nom="fleche" taille={20} />
						<span id="libelle-lancer">Lancer l’audit</span>
					</button>
				</div>
			</div>
		</section>

		{/* erreurs */}
		<section id="etat-erreur" hidden class="mt-8 rounded-box border border-obsidian-border bg-obsidian-card p-6">
			<h2 class="font-titre tracking-[0.02em] flex items-center gap-2.5 text-xl">
				<Icone nom="alerte" taille={22} classe="text-primary" />
				<span id="titre-erreur">Audit impossible</span>
			</h2>
			{/* Texte d'état en `text-echec` : conforme AA, contrairement au carmin. */}
			<p id="message-erreur" class="mt-3 text-echec"></p>
			<p id="detail-erreur" class="mt-3 text-cream-muted"></p>
			<p class="mt-6 flex flex-wrap gap-3">
				<a href="/" class="btn btn-primary gap-2">
					<Icone nom="retour" taille={20} />
					Revenir au formulaire
				</a>
				<button type="button" id="reessayer" class="btn btn-ghost">Réessayer</button>
			</p>
		</section>
	</div>
</Layout>
	)
}

<script>
	import { routes } from "../../lib/api.js";
	import { DUREE_PAGE_ESTIMEE_MS, SELECTION_PAR_DEFAUT, SEUIL_AUDIT_LONG } from "../../lib/identite.js";
	import { abregerCible, enregistrerAudit } from "../../lib/historique.js";
	import {
		abregerUrl,
		appeler,
		creerPolling,
		formaterDuree,
		lireDonneesInitiales,
		lireJobId,
	} from "../../scripts/job.js";
	import { initialiserChoixMode } from "../../scripts/mode-audit.js";

	// L'interface est masquée dans le HTML (`hidden` sur #application) et révélée ici : c'est ce qui
	// garantit que l'utilisateur sans JavaScript voit le bloc <noscript> et RIEN d'autre, plutôt
	// qu'un écran de chargement qui ne finira jamais.
	const application = document.querySelector<HTMLElement>("#application");

	/** État déjà obtenu par le serveur : évite le premier aller-retour. */
	const initiales = lireDonneesInitiales();
	const jobId = lireJobId();

	/** Panneaux d'état, exclusifs les uns des autres. */
	const panneaux = {
		attente: document.querySelector<HTMLElement>("#etat-attente"),
		liste: document.querySelector<HTMLElement>("#etat-liste"),
		erreur: document.querySelector<HTMLElement>("#etat-erreur"),
	};

	function montrer(nom) {
		for (const [cle, element] of Object.entries(panneaux)) {
			element.hidden = cle !== nom;
		}
	}

	/** Affiche une erreur. */
	function echouer(genre, message) {
		const titre = document.querySelector("#titre-erreur");
		const detail = document.querySelector("#detail-erreur");

		if (genre === "introuvable") {
			titre.textContent = "Audit introuvable";
			detail.textContent =
				"Cet audit n’existe pas sur cette machine : il a sans doute été effacé depuis " +
				"« Mes audits », ou le dossier data/ a été vidé. Relancez-le depuis le formulaire.";
		} else if (genre === "reseau") {
			titre.textContent = "Serveur injoignable";
			detail.textContent =
				"Le serveur d’audit local ne répond pas. Vérifiez que « npm run dev » tourne " +
				"toujours : l’audit n’est pas perdu pour autant.";
		} else {
			titre.textContent = "Audit impossible";
			detail.textContent = "";
		}

		document.querySelector("#message-erreur").textContent = message;
		montrer("erreur");
	}

	document.querySelector("#reessayer")?.addEventListener("click", () => {
		window.location.reload();
	});

	// Audit introuvable : le serveur a rendu l'explication À LA PLACE de l'interface (pas de
	// #application).
	if (application) {
		application.hidden = false;

		// Le chargeur est rendu masqué (voir `Chargeur.astro`) : on part donc explicitement sur l'écran
		// d'attente.
		montrer("attente");

		if (!jobId) {
			echouer("introuvable", "Aucun numéro d’audit dans l’adresse de cette page.");
		} else {
			demarrer(jobId);
		}
	}

	function demarrer(id) {
		/** Origine de la cible, servie de garde-fou à l'ajout manuel. */
		let origine = null;

		const liste = document.querySelector<HTMLElement>("#liste-pages");
		const resume = document.querySelector("#resume-selection");
		const boutonLancer = document.querySelector<HTMLButtonElement>("#lancer-audit");

		/* Mode d'audit (arrière-plan, personnalisé, rapide). */
		let modeAudit = null;
		modeAudit = initialiserChoixMode({
			nombrePages: () => selection().length,
			auChangement: () => rafraichirResume(),
		});

		/* Poll de la découverte. */
		/** Applique un état de découverte à la page. */
		function appliquerEtat(etat) {
			document.querySelector("#cible").textContent = abregerUrl(etat.targetUrl, 80);
			enregistrerAudit({ i: Number(id), u: abregerCible(etat.targetUrl), s: etat.status, v: Date.now() });

			// La découverte a échoué côté serveur : inutile de continuer à interroger.
			if (etat.status === "error") {
				echouer("refus", etat.error || "La découverte des pages a échoué.");
				return false;
			}

			// L'audit a déjà été lancé (second onglet, ou lancement survenu pendant que la page était
			// ouverte) : il n'y a plus rien à sélectionner, on va droit au rapport.
			if (["queued", "running", "done", "stopped"].includes(etat.status)) {
				window.location.replace(`/rapport/${id}`);
				return false;
			}

			// Découverte encore en cours : on garde l'écran d'attente et on repasse dans 2 s.
			if (!etat.ready) return true;

			origine = lireOrigine(etat.targetUrl);
			afficherPages(etat.discoveredUrls);
			montrer("liste");
			return false;
		}

		/* Hydratation : le serveur a déjà interrogé l'API pendant le rendu de la page. */
		let etatHydrate = false;
		if (initiales.etat) {
			etatHydrate = true;
			if (appliquerEtat(initiales.etat) === false) return;
		}

		const polling = creerPolling(async () => {
			try {
				return appliquerEtat(await appeler(routes.decouverte(id)));
			} catch (erreur) {
				echouer(erreur.genre, erreur.message);
				return false;
			}
		}, 2000, { immediat: !etatHydrate });

		/* rendu de la liste */

		function afficherPages(urls) {
			document.querySelector("#compteur-decouvertes").textContent = `(${urls.length})`;
			document.querySelector("#prefixe-origine").textContent = origine ?? "";

			// Les {SELECTION_PAR_DEFAUT} premières pages sont cochées d'office : c'est l'ordre du plan de
			// site (ou de la découverte), donc en général l'accueil et les pages principales.
			liste.replaceChildren(...urls.map((url, rang) => creerLigne(url, false, rang < SELECTION_PAR_DEFAUT)));
			rafraichirResume();
		}

		// Une ligne = une case à cocher CARRÉE (jamais ronde : un rond se lit comme un bouton radio, or
		// ces choix sont cumulables) et l'URL complète, sélectionnable.
		function creerLigne(url, ajoutee = false, cochee = true) {
			const element = document.createElement("li");
			element.className = "flex items-start gap-3 py-3 transition-opacity duration-200 has-[:disabled]:opacity-50";

			const case_ = document.createElement("input");
			case_.type = "checkbox";
			// Case CARRÉE (`rounded-[0.25rem]`) : une forme ronde se lirait comme un bouton radio, « un
			// choix parmi plusieurs », alors que ces cases sont cumulables.
			case_.className = "checkbox checkbox-primary mt-0.5 shrink-0 rounded-[0.25rem]";
			case_.checked = cochee;
			case_.value = url;
			case_.id = `page-${liste.children.length}-${Date.now()}`;
			case_.addEventListener("change", () => rafraichirResume());

			const etiquette = document.createElement("label");
			etiquette.htmlFor = case_.id;
			etiquette.className = "min-w-0 flex-1 cursor-pointer";

			const texte = document.createElement("span");
			texte.className = "block break-all text-sm";
			texte.textContent = url;
			etiquette.append(texte);

			if (ajoutee) {
				const marque = document.createElement("span");
				marque.className = "font-corps text-micro tracking-hud uppercase text-cream-dark mt-1 block";
				marque.textContent = "Ajoutée manuellement";
				etiquette.append(marque);
			}

			element.append(case_, etiquette);
			return element;
		}

		/** Les cases cochées, dans l'ordre d'affichage. */
		function selection() {
			return [...liste.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')].map((c) => c.value);
		}

		/** Met à jour le résumé. */
		function rafraichirResume() {
			const nombre = selection().length;

			const avertissement = document.querySelector<HTMLElement>("#avertissement-long");
			avertissement.hidden = nombre <= SEUIL_AUDIT_LONG;
			if (nombre > SEUIL_AUDIT_LONG) {
				avertissement.textContent =
					`Attention : avec ${nombre} pages, l’audit peut être très long (environ ` +
					`${formaterDuree(Math.ceil(nombre / (modeAudit?.simultanes() ?? 1)) * DUREE_PAGE_ESTIMEE_MS)}). Vous pourrez l’arrêter à tout ` +
					"moment : les pages déjà mesurées seront conservées.";
			}

			resume.textContent =
				nombre === 0
					? "Aucune page sélectionnée."
					: `${nombre} page${nombre > 1 ? "s" : ""} sélectionnée${nombre > 1 ? "s" : ""}.`;
			boutonLancer.disabled = nombre === 0;
		}

		document.querySelector("#tout-cocher").addEventListener("click", () => {
			liste.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((c) => (c.checked = true));
			rafraichirResume();
		});

		document.querySelector("#tout-decocher").addEventListener("click", () => {
			liste.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((c) => (c.checked = false));
			rafraichirResume();
		});

		/* ajout manuel */

		const champ = document.querySelector<HTMLInputElement>("#chemin-manuel");
		const zoneErreurAjout = document.querySelector<HTMLElement>("#erreur-ajout");
		const texteErreurAjout = document.querySelector("#erreur-ajout-texte");

		function erreurAjout(message) {
			texteErreurAjout.textContent = message;
			zoneErreurAjout.hidden = false;
		}

		function ajouter() {
			zoneErreurAjout.hidden = true;
			const saisie = champ.value.trim();

			if (saisie === "") {
				erreurAjout("Indiquez le chemin de la page à ajouter, par exemple /contact.");
				return;
			}

			/* Validation côté client. */
			let candidate;
			try {
				candidate = new URL(saisie, origine);
			} catch {
				erreurAjout("Chemin invalide.");
				return;
			}

			if (candidate.origin !== origine) {
				erreurAjout(
					`Un audit ne peut porter que sur ${origine} : les pages d’un autre domaine sont refusées.`,
				);
				return;
			}

			// Le fragment n'a aucun sens pour un audit de page, l'API le retire de son côté.
			candidate.hash = "";
			const url = candidate.toString();

			const deja = [...liste.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')].find(
				(c) => c.value === url,
			);
			if (deja) {
				// Plutôt qu'un doublon : on recoche la ligne existante.
				deja.checked = true;
				deja.closest("li")?.scrollIntoView({ block: "nearest" });
				erreurAjout("Cette page figurait déjà dans la liste : elle a été cochée.");
				champ.value = "";
				rafraichirResume();
				return;
			}

			liste.append(creerLigne(url, true, true));
			champ.value = "";
			rafraichirResume();
			champ.focus();
		}

		document.querySelector("#ajouter-page").addEventListener("click", ajouter);

		// Entrée dans le champ ajoute la page, sans soumettre quoi que ce soit.
		champ.addEventListener("keydown", (evenement) => {
			if (evenement.key === "Enter") {
				evenement.preventDefault();
				ajouter();
			}
		});

		/* lancement */

		const libelleLancer = document.querySelector("#libelle-lancer");
		const zoneErreurLancement = document.querySelector<HTMLElement>("#erreur-lancement");
		const texteErreurLancement = document.querySelector("#erreur-lancement-texte");

		boutonLancer.addEventListener("click", async () => {
			zoneErreurLancement.hidden = true;
			const urls = selection();

			if (urls.length === 0) {
				texteErreurLancement.textContent = "Sélectionnez au moins une page à auditer.";
				zoneErreurLancement.hidden = false;
				return;
			}

			boutonLancer.disabled = true;
			libelleLancer.textContent = "Lancement…";

			try {
				// Refus possibles, affichés tels quels sous le bouton : un autre audit tourne déjà (409 avec
				// `auditEnCours`), ou aucun navigateur n'a été trouvé (503, avec la marche à suivre).
				await appeler(routes.auditer(id), {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						selectedUrls: urls,
						mode: modeAudit?.mode() ?? "personnalise",
						simultanes: modeAudit?.simultanes() ?? 1,
					}),
				});

				enregistrerAudit({ i: Number(id), s: "running", n: urls.length, v: Date.now() });
				polling.stop();
				window.location.replace(`/rapport/${id}`);
			} catch (erreur) {
				// 409 : le job n'est plus en attente de validation — le plus souvent un double clic, ou un
				// audit déjà lancé depuis un autre onglet.
				if (erreur.statut === 409 && !erreur.corps?.auditEnCours) {
					polling.stop();
					window.location.replace(`/rapport/${id}`);
					return;
				}

				if (erreur.genre === "introuvable") {
					echouer("introuvable", erreur.message);
					return;
				}

				boutonLancer.disabled = false;
				libelleLancer.textContent = "Lancer l’audit";
				texteErreurLancement.textContent = erreur.message;
				zoneErreurLancement.hidden = false;
			}
		});
	}

	/** Origine d'une URL cible, ou `null` si elle est illisible. */
	function lireOrigine(url) {
		try {
			return new URL(url).origin;
		} catch {
			return null;
		}
	}
</script>
