# ---------------------------------------------------------------------------
# eco-audit — réglages optionnels.
# Copiez ce fichier en .env (à la racine du dépôt) seulement si vous voulez
# changer une valeur : tout fonctionne sans.
# ---------------------------------------------------------------------------

# Port du serveur d'audit local (écoute sur 127.0.0.1 uniquement).
# L'interface relaie /api vers ce port.
PORT=4322

# Port de l'interface : http://localhost:4321 par défaut.
# WEB_PORT=4321

# Chemin complet du navigateur à utiliser, si la détection automatique échoue
# ou si vous voulez forcer un autre Chrome / Edge.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Durée maximale d'un run Lighthouse (ms). Au-delà, Chrome est tué et la page
# est marquée en erreur.
ECO_AUDIT_RUN_TIMEOUT=180000

# Throttling du run BUREAU :
#   provided (défaut) — aucune simulation : mesure votre vraie machine et votre vrai réseau ;
#   simulate          — preset bureau officiel de Lighthouse, comme PageSpeed Insights.
# ECO_AUDIT_DESKTOP_THROTTLING=provided

# Nombre maximal de pages PROPOSÉES par la découverte (sitemap ou crawl).
# Pas une limite d'audit : un garde-fou pour que le crawl d'un très gros site se termine.
# ECO_AUDIT_MAX_DECOUVERTE=500

# Mettre à 1 pour désactiver l'accélération graphique de Chrome (à tester si
# Chrome se bloque pendant un audit ; peut ralentir un peu les mesures de rendu).
# ECO_AUDIT_DISABLE_GPU=0
