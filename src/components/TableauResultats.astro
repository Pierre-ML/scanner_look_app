---
/** Coquille du tableau détaillé page par page. */
import Icone from "./Icone.astro";
---

<div class="overflow-x-auto rounded-box border border-base-300">
	<table class="w-full min-w-[64rem] border-collapse text-sm">
		<caption class="sr-only">
			Résultats détaillés par page : scores Lighthouse bureau et mobile, éco-index et durée
			de mesure.
		</caption>

		<thead class="bg-base-200">
			<tr>
				<th scope="col" rowspan="2" class="p-3 text-left align-bottom font-serif tracking-wide">
					Page
				</th>
				<th scope="col" rowspan="2" class="p-3 text-left align-bottom font-serif tracking-wide">
					État
				</th>
				<th scope="col" colspan="4" class="border-b border-base-300 p-3 text-center">
					<span class="inline-flex items-center gap-2 font-serif tracking-wide">
						<Icone nom="bureau" taille={18} classe="text-primary" />
						Bureau
					</span>
				</th>
				<th scope="col" colspan="4" class="border-b border-l border-base-300 p-3 text-center">
					<span class="inline-flex items-center gap-2 font-serif tracking-wide">
						<Icone nom="mobile" taille={18} classe="text-primary" />
						Mobile
					</span>
				</th>
				<th scope="col" rowspan="2" class="border-l border-base-300 p-3 text-center align-bottom font-serif tracking-wide">
					<span class="inline-flex items-center gap-2">
						<Icone nom="feuille" taille={18} classe="text-primary" />
						Éco-index
					</span>
				</th>
				<th scope="col" rowspan="2" class="p-3 text-right align-bottom font-serif tracking-wide">
					<span class="inline-flex items-center gap-2">
						<Icone nom="chrono" taille={18} classe="text-primary" />
						Durée
					</span>
				</th>
			</tr>
			<tr class="text-micro tracking-hud uppercase text-muted">
				<th scope="col" class="p-2 text-center" title="Performance">Perf</th>
				<th scope="col" class="p-2 text-center" title="Accessibilité">A11y</th>
				<th scope="col" class="p-2 text-center" title="Bonnes pratiques">BP</th>
				<th scope="col" class="p-2 text-center">SEO</th>
				<th scope="col" class="border-l border-base-300 p-2 text-center" title="Performance">
					Perf
				</th>
				<th scope="col" class="p-2 text-center" title="Accessibilité">A11y</th>
				<th scope="col" class="p-2 text-center" title="Bonnes pratiques">BP</th>
				<th scope="col" class="p-2 text-center">SEO</th>
			</tr>
		</thead>

		<tbody id="lignes-resultats" class="divide-y divide-base-300">
			<tr>
				<td colspan="11" class="p-6 text-center text-muted">
					Aucune page mesurée pour l’instant.
				</td>
			</tr>
		</tbody>
	</table>
</div>
